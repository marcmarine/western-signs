{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "plugin": ["varvara-typedoc-theme"],
  "theme": "varvara-css",
  "includeVersion": true,
  "navigationLinks": {
    "GitHub": "https://github.com/marcmarine/western-signs"
  },
  "router": "kind-dir",
  "groupOrder": ["Functions", "*"],
  "validation": {
    "notExported": false
  },
  "customCss": "./typedoc-custom.css",
  "headings": {
    "readme": false
  },
  "navigation": {
    "includeGroups": true
  }
}
