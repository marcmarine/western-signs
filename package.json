{
  "name": "western-signs",
  "version": "1.16.0",
  "author": "Marc Mariné <shenobi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcmarine/western-signs.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.3.13",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.3",
    "typedoc": "^0.28.19",
    "varvara-typedoc-theme": "^0.3.9"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/es": {
      "types": "./dist/locale/es.d.ts",
      "default": "./dist/locale/es.js"
    },
    "./locale/ca": {
      "types": "./dist/locale/ca.d.ts",
      "default": "./dist/locale/ca.js"
    },
    "./data.json": "./dist/data.json",
    "./locale/*.json": "./dist/locale/*.json"
  },
  "bugs": "https://github.com/marcmarine/western-signs/issues/new",
  "description": "Western astrology data for signs, planets, houses and aspects, with translations, SVG symbols and the Sun's position for any date.",
  "files": [
    "dist"
  ],
  "homepage": "https://marcmarine.github.io/western-signs",
  "keywords": [
    "astrology",
    "zodiac",
    "zodiac-sign",
    "star-sign",
    "sun-sign",
    "horoscope",
    "planets",
    "houses",
    "aspects",
    "zodiac-icons",
    "sun-position",
    "meeus",
    "i18n",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun run build:types && bun build.ts && bun build-data.ts",
    "build:types": "bunx tsc --project tsconfig.types.json",
    "build:docs": "bunx typedoc",
    "format": "biome check --write",
    "prebuild": "rm -rf dist && bun build-symbols.ts"
  },
  "type": "module",
  "sideEffects": [
    "./dist/locale/*",
    "./src/index.ts"
  ],
  "types": "./dist/index.d.ts"
}
