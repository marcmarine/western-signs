{
  "name": "western-signs",
  "version": "1.13.5",
  "author": "Marc Mariné <shenobi@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcmarine/western-signs.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.3.13",
    "semantic-release": "^25.0.3",
    "typedoc": "^0.28.19",
    "varvara-typedoc-theme": "^0.3.9"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/es": {
      "types": "./dist/locale/es.d.ts",
      "default": "./dist/locale/es.js"
    },
    "./locale/ca": {
      "types": "./dist/locale/ca.d.ts",
      "default": "./dist/locale/ca.js"
    }
  },
  "bugs": "https://github.com/marcmarine/western-signs/issues/new",
  "description": "Simple interface for western astrological signs.",
  "files": [
    "dist"
  ],
  "homepage": "https://marcmarine.github.io/western-signs",
  "keywords": [
    "astrology",
    "zodiac",
    "horoscope",
    "western-signs",
    "signs"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun run build:types && bun build.ts",
    "build:types": "bunx tsc --project tsconfig.types.json",
    "build:docs": "bunx typedoc",
    "format": "biome check --write",
    "prebuild": "bun build-symbols.ts"
  },
  "type": "module",
  "sideEffects": [
    "./dist/locale/*"
  ],
  "types": "./dist/index.d.ts"
}
